rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function userDoc(uid) {
      return get(userPath(uid));
    }

    function currentUserExists() {
      return signedIn() && userExists(request.auth.uid);
    }

    function currentUserRole() {
      return currentUserExists()
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    // Super Admin is identified by TWO equivalent paths (both are checked):
    //   1. users/{uid}.role == "super_admin"  — primary, set by Admin SDK on creation/transfer
    //   2. settings/app.superAdminEmail matches signed-in email — safety net for bootstrap
    //      accounts that were manually created before the role field was properly set,
    //      and to stay consistent with AuthContext.isSuperAdmin computation.
    function isSuperAdmin() {
      return signedIn() && (
        currentUserRole() == "super_admin" ||
        (
          exists(/databases/$(database)/documents/settings/app) &&
          get(/databases/$(database)/documents/settings/app).data.superAdminEmail.lower()
            == request.auth.token.email.lower()
        )
      );
    }

    // Covers all non-super-admin operational and legacy admin roles.
    // "operations" is included so all AF Procurement Hub operational roles work.
    function isAssistantAdmin() {
      return signedIn() && currentUserRole() in [
        "ceo", "evp", "operations", "planning", "finance", "procurement",
        "assistant_admin"
      ];
    }

    function isAdmin() {
      return isSuperAdmin() || isAssistantAdmin();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Valid roles for new document writes.
    function validRole(role) {
      return role in [
        "super_admin",
        "ceo", "evp", "operations", "planning", "finance", "procurement"
      ];
    }

    // Used for creates — only new procurement categories accepted
    function validRequestCategory(category) {
      return category in [
        "Purchase Request",
        "Vendor Approval",
        "Contract Review",
        "Budget Request",
        "Supplier Onboarding",
        "Violation Report"
      ];
    }

    // Used for updates — also accepts legacy legal categories until data migration is complete
    function validRequestCategoryForUpdate(category) {
      return validRequestCategory(category) || category in [
        "Amicable Settlement",
        "Complaint",
        "Legal Consultation",
        "Investigation Request",
        "Contract Issue"
      ];
    }

    // Used for creates — only new procurement statuses accepted
    function validRequestStatus(status) {
      return status in [
        "Submitted",
        "Under Review",
        "CEO Review",
        "EVP Review",
        "Planning Review",
        "Finance Review",
        "Approved / PO Issued",
        "Rejected"
      ];
    }

    // Used for updates — also accepts legacy statuses until data migration is complete
    function validRequestStatusForUpdate(status) {
      return validRequestStatus(status) || status in [
        "Employee Contacted",
        "In Progress",
        "Proposed Resolution",
        "Employee Feedback",
        "Resolved / Closed",
        "Escalated"
      ];
    }

    function validProfileChangeField(field) {
      return field in ["phone", "employeeNumber"];
    }

    function validProfileChangeStatus(status) {
      return status in ["pending", "approved", "rejected", "cancelled"];
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/requests/$(requestId);
    }

    function requestExists(requestId) {
      return exists(requestPath(requestId));
    }

    function requestDoc(requestId) {
      return get(requestPath(requestId));
    }

    function isRequestParticipantByRequestId(requestId) {
      return signedIn()
        && requestExists(requestId)
        && (
          requestDoc(requestId).data.userId == request.auth.uid ||
          (
            "targetEmployeeUid" in requestDoc(requestId).data &&
            requestDoc(requestId).data.targetEmployeeUid == request.auth.uid
          ) ||
          isAdmin()
        );
    }

    function isRequestParticipantFromResource() {
      return signedIn() && (
        resource.data.userId == request.auth.uid ||
        (
          "targetEmployeeUid" in resource.data &&
          resource.data.targetEmployeeUid == request.auth.uid
        ) ||
        isAdmin()
      );
    }

    function bothMissingOrSame(field) {
      return (
        !(field in resource.data) && !(field in request.resource.data)
      ) || (
        (field in resource.data) &&
        (field in request.resource.data) &&
        request.resource.data[field] == resource.data[field]
      );
    }

    // =========================
    // public_config helpers
    // =========================
    function publicConfigPath(docId) {
      return /databases/$(database)/documents/public_config/$(docId);
    }

    function publicConfigExists(docId) {
      return exists(publicConfigPath(docId));
    }

    function publicConfigDoc(docId) {
      return get(publicConfigPath(docId));
    }

    function allowUserSignup() {
      return !publicConfigExists("app")
        || !("allowUserSignup" in publicConfigDoc("app").data)
        || publicConfigDoc("app").data.allowUserSignup == true;
    }

    // =========================
    // users
    // =========================
    match /users/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      // Self-registration: role must be "procurement" (the default operational
      // role for new employees). canSubmitRequests may be omitted or set to
      // false at registration; the app always writes false and Super Admin
      // assigns it later.
      allow create: if allowUserSignup()
        && isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.role == "procurement"
        && request.resource.data.employeeNumber is string
        && request.resource.data.employeeNumber.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0;

      allow update: if
        // ── Normal user — self-update whitelist ──────────────────────────
        (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            !("isActive" in resource.data) ||
            (
              "isActive" in request.resource.data &&
              request.resource.data.isActive == resource.data.isActive
            )
          )
          && (
            !("canSubmitRequests" in resource.data) ||
            (
              "canSubmitRequests" in request.resource.data &&
              request.resource.data.canSubmitRequests == resource.data.canSubmitRequests
            )
          )
          && request.resource.data.employeeNumber == resource.data.employeeNumber
          && request.resource.data.phone == resource.data.phone
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "department",
            "language",
            "updatedAt"
          ])
        )
        ||
        // ── Super Admin — full profile management ─────────────────────────
        (
          isSuperAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
          && validRole(request.resource.data.role)
          && request.resource.data.employeeNumber is string
          && request.resource.data.employeeNumber.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.phone.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "displayName",
            "department",
            "phone",
            "language",
            "employeeNumber",
            "updatedAt",
            "isActive",
            "role",
            "canSubmitRequests"
          ])
        );

      allow delete: if isSuperAdmin();
    }

    // =========================
    // user_phone_index
    // Document ID = normalized phone (digits only, 966XXXXXXXXX format).
    // Document data = { uid, phone, createdAt }
    // Client reads DENIED — uniqueness enforced server-side via Admin SDK.
    // Do NOT expose publicly; phone numbers are PII.
    // =========================
    match /user_phone_index/{normalizedPhone} {
      allow get: if false;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.phone is string
        && request.resource.data.phone == normalizedPhone
        && !exists(/databases/$(database)/documents/user_phone_index/$(normalizedPhone))
        && (
          (
            allowUserSignup()
            && request.resource.data.uid == request.auth.uid
          )
          ||
          (
            isSuperAdmin()
            && request.resource.data.uid is string
            && request.resource.data.uid.size() > 0
          )
        );

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =========================
    // user_employee_index
    // Document ID = trimmed employee number string.
    // Document data = { uid, email, employeeNumber, createdAt }
    //
    // Public GET is intentionally allowed — employee number login must be able to
    // resolve the associated email before the user is authenticated.
    // LIST is denied to prevent enumeration of all employee numbers.
    // =========================
    match /user_employee_index/{employeeNumber} {
      allow get: if true;   // public — required for employee-number login before auth
      allow list: if false; // no enumeration

      allow create: if signedIn()
        && request.resource.data.employeeNumber is string
        && request.resource.data.employeeNumber == employeeNumber
        && !exists(/databases/$(database)/documents/user_employee_index/$(employeeNumber))
        && (
          (
            allowUserSignup()
            && request.resource.data.uid == request.auth.uid
          )
          ||
          (
            isSuperAdmin()
            && request.resource.data.uid is string
            && request.resource.data.uid.size() > 0
          )
        );

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =========================
    // public_config
    // =========================
    match /public_config/{docId} {
      allow read: if docId == "app";
      allow create, update, delete: if isSuperAdmin();
    }

    // =========================
    // profile_change_requests
    // =========================
    match /profile_change_requests/{docId} {

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validProfileChangeField(request.resource.data.field)
        && validProfileChangeStatus(request.resource.data.status)
        && request.resource.data.status == "pending"
        && request.resource.data.currentValue is string
        && request.resource.data.currentValue.size() > 0
        && request.resource.data.requestedValue is string
        && request.resource.data.requestedValue.size() > 0
        && request.resource.data.requestedValue != request.resource.data.currentValue;

      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSuperAdmin()
        && resource.data.userId == request.resource.data.userId
        && resource.data.field == request.resource.data.field
        && resource.data.currentValue == request.resource.data.currentValue
        && resource.data.requestedValue == request.resource.data.requestedValue
        && validProfileChangeStatus(request.resource.data.status);

      allow delete: if isSuperAdmin();
    }

    // =========================
    // requests  (legacy collection — kept for backward compat)
    // =========================
    match /requests/{requestId} {

      allow create: if signedIn()
        && validRequestCategory(request.resource.data.category)
        && validRequestStatus(request.resource.data.status)
        && (
          (
            request.resource.data.userId == request.auth.uid
            && currentUserExists()
            && userDoc(request.auth.uid).data.get("canSubmitRequests", false) == true
            && (
              !("createdByAdmin" in request.resource.data) ||
              request.resource.data.createdByAdmin == false
            )
          )
          ||
          (
            isAdmin()
            && ("createdByAdmin" in request.resource.data)
            && request.resource.data.createdByAdmin == true
            && request.resource.data.createdByAdminUid == request.auth.uid
            && ("targetEmployeeUid" in request.resource.data)
            && ("targetEmployeeNumber" in request.resource.data)
          )
        );

      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        (
          "targetEmployeeUid" in resource.data &&
          resource.data.targetEmployeeUid == request.auth.uid
        ) ||
        isAdmin()
      );

      allow update: if signedIn() && (
        (
          isRequestParticipantFromResource()
          && !isAdmin()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
          && request.resource.data.statusChangedBy == resource.data.statusChangedBy
          && request.resource.data.statusChangedAt == resource.data.statusChangedAt
          && request.resource.data.closedBy == resource.data.closedBy
          && request.resource.data.closedAt == resource.data.closedAt
          && request.resource.data.category == resource.data.category
          && bothMissingOrSame("createdByAdmin")
          && bothMissingOrSame("createdByAdminUid")
          && bothMissingOrSame("targetEmployeeUid")
          && bothMissingOrSame("targetEmployeeNumber")
        )
        ||
        (
          isAdmin()
          && validRequestCategoryForUpdate(request.resource.data.category)
          && validRequestStatusForUpdate(request.resource.data.status)
          && request.resource.data.userId == resource.data.userId
          && bothMissingOrSame("createdByAdmin")
          && bothMissingOrSame("createdByAdminUid")
          && bothMissingOrSame("targetEmployeeUid")
          && bothMissingOrSame("targetEmployeeNumber")
        )
      );

      allow delete: if isSuperAdmin();
    }

    // =========================
    // request_messages
    // =========================
    match /request_messages/{messageId} {

      allow create: if signedIn()
        && ("requestId" in request.resource.data)
        && isRequestParticipantByRequestId(request.resource.data.requestId);

      allow read: if signedIn()
        && ("requestId" in resource.data)
        && isRequestParticipantByRequestId(resource.data.requestId);

      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // =========================
    // deletion_requests
    // =========================
    match /deletion_requests/{docId} {

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =========================
    // settings
    // =========================
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // =========================
    // audit_logs
    // =========================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // =========================
    // procurement_requests
    // Super Admin and all operational/admin roles can read all.
    // Users with canSubmitRequests=true can create.
    // Stage transitions done by api-server via Admin SDK (bypasses rules).
    // =========================
    match /procurement_requests/{requestId} {
      allow create: if signedIn() && (
        isAdmin() ||
        (currentUserExists() && userDoc(request.auth.uid).data.get("canSubmitRequests", false) == true)
      );

      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.createdByUid == request.auth.uid
      );

      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // =========================
    // workflow_events
    // =========================
    match /workflow_events/{eventId} {
      allow create: if signedIn() && (
        isAdmin() ||
        (currentUserExists() && userDoc(request.auth.uid).data.get("canSubmitRequests", false) == true)
      );

      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.actorUid == request.auth.uid
      );

      allow update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}
